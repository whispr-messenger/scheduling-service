# Configuration de développement pour scheduling-service
# Base de données SQLite (pour développement local)
DATABASE_URL="file:./dev.db"

# Cache en mémoire (fallback sans Redis)
REDIS_HOST=""
REDIS_PORT=""
REDIS_PASSWORD=""
REDIS_DB=""

# JWT Configuration
JWT_SECRET="dev-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="1d"
JWT_ISSUER="auth-service"
JWT_AUDIENCE="scheduling-service,whispr-services"

# Services externes (simulés en développement)
AUTH_SERVICE_URL="http://localhost:4000"
USER_SERVICE_URL="http://localhost:4001"
MESSAGING_SERVICE_URL="http://localhost:4004"
NOTIFICATION_SERVICE_URL="http://localhost:4002"

# Application Configuration
PORT=4005
NODE_ENV=development

# Bull Queue Configuration (désactivé sans Redis)
BULL_REDIS_HOST=""
BULL_REDIS_PORT=""
BULL_REDIS_DB=""
QUEUE_ENABLED=false

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Monitoring
HEALTH_CHECK_TIMEOUT=5000
METRICS_ENABLED=true

# Logging
LOG_LEVEL=debug

# Timezone par défaut
DEFAULT_TIMEZONE="UTC"

# Sécurité
CORS_ORIGIN="http://localhost:3000"
HELMET_ENABLED=true

# Mode développement
DEV_MODE=true