# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/scheduling_service?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=1d

# Bull Queue Configuration
QUEUE_CONCURRENCY=10
QUEUE_MAX_RETRIES=3

# Service Discovery
MESSAGING_SERVICE_URL=messaging-service:50051
NOTIFICATION_SERVICE_URL=notification-service:50051
MEDIA_SERVICE_URL=media-service:50051
USER_SERVICE_URL=user-service:50051
AUTH_SERVICE_URL=auth-service:50051
MODERATION_SERVICE_URL=moderation-service:50051

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_TIMEOUT=5000

# Istio Service Mesh
ISTIO_ENABLED=false
SERVICE_MESH_ENABLED=false