# Whispr Scheduling Service - Environment Configuration

# Application
NODE_ENV=development
PORT=3001
GRPC_PORT=50051

# Database Configuration
DATABASE_URL=postgresql://scheduling_service:your_password@localhost:5432/whispr_scheduling
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=scheduling_service
DB_PASSWORD=your_password
DB_NAME=whispr_scheduling

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Scheduler Configuration
DEFAULT_TIMEZONE=UTC
MAX_CONCURRENT_JOBS=100
DEFAULT_JOB_TIMEOUT=300000
HEALTH_CHECK_INTERVAL=30000
RETRY_DELAY=60000
MAX_RETRIES=3
ENABLE_METRICS=true
ENABLE_AUDIT_LOGS=true

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGIN=*

# Swagger Documentation
SWAGGER_ENABLED=true

# Other Services (gRPC endpoints)
MESSAGING_SERVICE_HOST=messaging-service
MESSAGING_SERVICE_PORT=50052
NOTIFICATION_SERVICE_HOST=notification-service
NOTIFICATION_SERVICE_PORT=50053
MEDIA_SERVICE_HOST=media-service
MEDIA_SERVICE_PORT=50054
USER_SERVICE_HOST=user-service
USER_SERVICE_PORT=50055
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=50056

# Monitoring and Observability
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100