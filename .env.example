# Whispr Scheduling Service - Environment Configuration

# Application
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://scheduling_service:your_password@localhost:5432/whispr_scheduling
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=scheduling_service
DB_PASSWORD=your_password
DB_NAME=whispr_scheduling

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Scheduler Configuration
DEFAULT_TIMEZONE=UTC
MAX_CONCURRENT_JOBS=100
DEFAULT_JOB_TIMEOUT=300000
HEALTH_CHECK_INTERVAL=30000
RETRY_DELAY=60000
MAX_RETRIES=3
ENABLE_METRICS=true
ENABLE_AUDIT_LOGS=true

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGIN=*

# Swagger Documentation
SWAGGER_ENABLED=true

# Inter-service Redis pub/sub channels
# Other services subscribe to these channels to receive scheduled-event dispatches.
MESSAGING_EVENTS_CHANNEL=whispr.messaging.events
NOTIFICATION_EVENTS_CHANNEL=whispr.notification.events

# Monitoring and Observability
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100