generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScheduleType {
  CRON
  INTERVAL
  ONCE
  IMMEDIATE
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum DependencyType {
  SUCCESS
  COMPLETION
  FAILURE
}

model JobCategory {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique @db.VarChar(100)
  description       String?  @db.Text
  defaultPriority   Priority @default(MEDIUM) @map("default_priority")
  defaultTimeout    Int      @default(300) @map("default_timeout")
  defaultMaxRetries Int      @default(3) @map("default_max_retries")
  configuration     Json     @default("{}")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  jobs Job[]

  @@map("job_categories")
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(200)
  description    String?   @db.Text
  categoryId     String    @map("category_id") @db.Uuid
  targetService  String    @map("target_service") @db.VarChar(100)
  targetMethod   String    @map("target_method") @db.VarChar(100)
  payload        Json      @default("{}")
  priority       Priority  @default(MEDIUM)
  maxRetries     Int       @default(3) @map("max_retries")
  timeoutSeconds Int       @default(300) @map("timeout_seconds")
  isActive       Boolean   @default(true) @map("is_active")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(6)

  category      JobCategory     @relation(fields: [categoryId], references: [id])
  schedules     Schedule[]
  executions    Execution[]
  recurringJobs RecurringJob[]
  dependencies  JobDependency[] @relation("JobDependencies")
  dependents    JobDependency[] @relation("DependentJobs")

  @@index([categoryId], map: "jobs_category_id_idx")
  @@index([targetService], map: "jobs_target_service_idx")
  @@index([isActive], map: "jobs_is_active_idx")
  @@map("jobs")
}

model Schedule {
  id              String       @id @default(uuid()) @db.Uuid
  jobId           String       @map("job_id") @db.Uuid
  scheduleType    ScheduleType @map("schedule_type")
  cronExpression  String?      @map("cron_expression") @db.VarChar(100)
  intervalSeconds Int?         @map("interval_seconds")
  scheduledAt     DateTime?    @map("scheduled_at") @db.Timestamp(6)
  timezone        String       @default("UTC") @db.VarChar(50)
  startsAt        DateTime?    @map("starts_at") @db.Timestamp(6)
  endsAt          DateTime?    @map("ends_at") @db.Timestamp(6)
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  executions Execution[]

  @@index([jobId], map: "schedules_job_id_idx")
  @@index([isActive], map: "schedules_is_active_idx")
  @@map("schedules")
}

model Execution {
  id            String          @id @default(uuid()) @db.Uuid
  jobId         String          @map("job_id") @db.Uuid
  scheduleId    String?         @map("schedule_id") @db.Uuid
  status        ExecutionStatus
  startedAt     DateTime        @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt   DateTime?       @map("completed_at") @db.Timestamp(6)
  failedAt      DateTime?       @map("failed_at") @db.Timestamp(6)
  attemptNumber Int             @default(1) @map("attempt_number")
  resultData    Json?           @map("result_data")
  errorData     Json?           @map("error_data")
  durationMs    Int?            @map("duration_ms")
  workerId      String?         @map("worker_id") @db.VarChar(100)
  correlationId String?         @map("correlation_id") @db.VarChar(100)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamp(6)

  job      Job            @relation(fields: [jobId], references: [id])
  schedule Schedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  logs     ExecutionLog[]

  @@index([jobId], map: "executions_job_id_idx")
  @@index([status], map: "executions_status_idx")
  @@index([startedAt], map: "executions_started_at_idx")
  @@map("executions")
}

model ExecutionLog {
  id          String   @id @default(uuid()) @db.Uuid
  executionId String   @map("execution_id") @db.Uuid
  logLevel    LogLevel @map("log_level")
  message     String   @db.Text
  context     Json     @default("{}")
  loggedAt    DateTime @default(now()) @map("logged_at") @db.Timestamp(6)

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId], map: "execution_logs_execution_id_idx")
  @@index([logLevel], map: "execution_logs_log_level_idx")
  @@map("execution_logs")
}

model RecurringJob {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(200)
  patternType    String    @map("pattern_type") @db.VarChar(50)
  patternConfig  Json      @map("pattern_config")
  templateJobId  String    @map("template_job_id") @db.Uuid
  lastGenerated  DateTime? @map("last_generated") @db.Timestamp(6)
  nextGeneration DateTime? @map("next_generation") @db.Timestamp(6)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  templateJob Job @relation(fields: [templateJobId], references: [id])

  @@map("recurring_jobs")
}

model JobDependency {
  id               String         @id @default(uuid()) @db.Uuid
  jobId            String         @map("job_id") @db.Uuid
  dependsOnJobId   String         @map("depends_on_job_id") @db.Uuid
  dependencyType   DependencyType @map("dependency_type")
  dependencyConfig Json           @default("{}") @map("dependency_config")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp(6)

  job          Job @relation("JobDependencies", fields: [jobId], references: [id], onDelete: Cascade)
  dependsOnJob Job @relation("DependentJobs", fields: [dependsOnJobId], references: [id], onDelete: Cascade)

  @@unique([jobId, dependsOnJobId, dependencyType], map: "job_dependencies_job_id_depends_on_job_id_dependency_type_key")
  @@map("job_dependencies")
}
